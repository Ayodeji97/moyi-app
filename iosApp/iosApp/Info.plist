<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The launch screen (states.md §0): the wordmark on `surface`, nothing else, no
	     motion. Both are asset-catalog entries with a dark appearance, so the system
	     picks the pair for the current mode. Replaces the empty screen that
	     INFOPLIST_KEY_UILaunchScreen_Generation used to generate (now NO). The wordmark
	     PDFs are drawn by scripts/render-wordmark.swift. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchWordmark</string>
	</dict>
	<!-- The outbox's background send (IosOutboxScheduler): a BGAppRefreshTask, which needs
	     the fetch background mode. iOS runs it when it chooses, never on a schedule. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.moyi.app.outbox</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- PROPOSED copy (photos). Asked by iOS the first time "Take a photo" opens the camera
	     (UIImagePickerController). The photo library needs no usage string: PHPicker runs
	     out of process and hands over only the photo chosen. -->
	<key>NSCameraUsageDescription</key>
	<string>Moyi uses the camera only when you take a photo to add to your entry.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Moyi uses the microphone only when you record a voice note to add to your entry.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Moyi connects to a development server on your local network.</string>
</dict>
</plist>
