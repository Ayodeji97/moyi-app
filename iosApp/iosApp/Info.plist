<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Not here, on purpose: MoyiApiBaseUrl, and for Debug only the local-network keys
	     (NSAppTransportSecurity NSAllowsLocalNetworking, NSLocalNetworkUsageDescription).
	     The "API Base URL" build phase (iosApp/scripts/api-base-url.sh) writes them into the
	     built app per configuration: Debug talks to a local backend over plain HTTP, Release
	     to production over HTTPS with no ATS exception (README, "Which backend"). -->
	<!-- The launch screen: `surface` alone, static (an asset-catalog colour with a dark
	     appearance, so the system picks it for the current mode). The logo builds over
	     it in the first Compose frame (LaunchSplash, owner request 2026-11-09), which
	     starts as this same empty surface, so nothing jumps. It replaced the wordmark
	     that stood here (states.md §0): a static wordmark would have had to vanish for
	     the animation to build it. INFOPLIST_KEY_UILaunchScreen_Generation stays NO. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The outbox's background send (IosOutboxScheduler): a BGAppRefreshTask, which needs
	     the fetch background mode. iOS runs it when it chooses, never on a schedule. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.moyi.app.outbox</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- PROPOSED copy (photos). Asked by iOS the first time "Take a photo" opens the camera
	     (UIImagePickerController). The photo library needs no usage string: PHPicker runs
	     out of process and hands over only the photo chosen. -->
	<!-- Push (FCM): no method swizzling. AppDelegate hands FCM the APNs token itself
	     (NotificationDelegate.swift), and taps already go through its own
	     UNUserNotificationCenterDelegate, so nothing is done behind the app's back. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Moyi uses the camera only when you take a photo to add to your entry.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Moyi uses the microphone only when you record a voice note to add to your entry.</string>
</dict>
</plist>
