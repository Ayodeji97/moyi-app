// Your Apple Developer Team ID goes in Local.xcconfig next to this file, never here:
// the repository is public. See README, "Signing for a real iPhone".
TEAM_ID=

PRODUCT_NAME=Moyi
// getmoyi.app reversed, the same as Android's applicationId (issue #49). The Firebase iOS
// app and the APNs key are registered for exactly this ID.
PRODUCT_BUNDLE_IDENTIFIER=app.getmoyi.moyi

// Universal links for getmoyi.app (issue #49). Inert until two other things exist: the
// site's .well-known/apple-app-site-association (moyi-backend#157) and the Associated
// Domains capability on this App ID in the Apple developer portal. The paths that open
// the app are chosen by that file, not here: it must list none until the app routes them
// (no onContinueUserActivity yet), or a tapped link would open Moyi and do nothing.
CODE_SIGN_ENTITLEMENTS=iosApp/iosApp.entitlements

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// The Shared framework is static, so the app does the final link. SQLDelight's iOS
// driver (shared/data/database) calls the sqlite3 C API, and it must reach SQLCipher
// (the SQLCipher.swift package, linked by the target), never the system SQLite: so no
// -lsqlite3 here. Linking both would let one set of sqlite3 symbols win silently.
// Kotlin links SQLCipher for its own test binaries (KmpLibraryConventionPlugin).
OTHER_LDFLAGS=$(inherited)

// Optional and git-ignored: overrides TEAM_ID (and anything else) on this Mac only.
// The "?" means the build does not fail when the file is absent (CI, fresh clones).
#include? "Local.xcconfig"
