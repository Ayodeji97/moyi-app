# Moyi release lanes (README, "Releasing to TestFlight" and "Releasing to Google Play").
#
#   fastlane ios beta         archive the iOS Release build and upload it to TestFlight
#   fastlane android beta     build the signed Android release bundle and upload it to the
#                             Play internal track
#
# Run from the repository root. The helpers at the top are shared by both platforms.
#
# Secrets never live in this repository (it is public). The App Store Connect API key and
# the Play service account are read from ~/.moyi/, which only the owner fills in; the
# Android upload key's properties live in ~/.gradle/gradle.properties. No value from any
# of them is ever printed: messages name the variable, never what it holds.

require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)

# The production API: what every Release build must talk to, the same as
# iosApp/scripts/api-base-url.sh and build-logic ApiBaseUrl.kt.
PRODUCTION_API_BASE_URL = "https://api.getmoyi.app/api/v1"
BUNDLE_ID = "app.getmoyi.moyi"
FIREBASE_PROD_PROJECT = "moyi-prod"

RELEASE_ENV_DEFAULT = "~/.moyi/release.env"
# Deliberately not APP_STORE_CONNECT_API_KEY_PATH: fastlane's pilot and
# latest_testflight_build_number read that name on their own and expect a JSON key file,
# not a .p8 (StitchPad learned this the hard way).
RELEASE_ENV_KEYS = %w[
  APP_STORE_CONNECT_API_KEY_ID
  APP_STORE_CONNECT_API_ISSUER_ID
  ASC_API_KEY_P8_PATH
].freeze

IOS_BUILD_DIR = File.join(REPO_ROOT, "build", "ios-release")

# --- Shared helpers ----------------------------------------------------------------------

# Runs a command without a shell and without fastlane echoing it. Returns [stdout, ok].
def quiet(*cmd)
  out, _err, status = Open3.capture3(*cmd)
  [out.strip, status.success?]
end

# One value from a plist (binary or XML), or nil when the key is absent.
def plist_value(path, key)
  out, ok = quiet("plutil", "-extract", key, "raw", "-o", "-", path)
  ok ? out : nil
end

def plist_has_key?(path, key)
  _out, ok = quiet("plutil", "-extract", key, "xml1", "-o", "-", path)
  ok
end

# The commit being released. Refuses a dirty tree, so what is uploaded is exactly a commit.
def require_clean_commit!
  status, ok = quiet("git", "-C", REPO_ROOT, "status", "--porcelain")
  UI.user_error!("git status failed: is #{REPO_ROOT} a git checkout?") unless ok
  unless status.empty?
    UI.user_error!(
      "The working tree has uncommitted changes. Commit or stash them first, so the " \
      "build that is uploaded matches a commit:\n#{status}"
    )
  end
  sha, = quiet("git", "-C", REPO_ROOT, "rev-parse", "HEAD")
  branch, = quiet("git", "-C", REPO_ROOT, "rev-parse", "--abbrev-ref", "HEAD")
  UI.message("Releasing commit #{sha} (#{branch})")
  sha
end

# Warns when a secret file can be read by other users of this Mac.
def warn_if_shared!(path)
  mode = File.stat(path).mode & 0o777
  return if (mode & 0o077).zero?
  UI.important("#{path} is readable by other users (mode #{format('%o', mode)}). Run: chmod 600 #{path}")
end

# Reads ~/.moyi/release.env (or $MOYI_RELEASE_ENV) into ENV. KEY=VALUE lines, # comments,
# optional `export ` and quotes. A variable already set in the environment wins, so a CI
# runner can provide them without the file. Only the keys named are read. Returns the path.
def read_release_env!(keys)
  path = File.expand_path(ENV.fetch("MOYI_RELEASE_ENV", RELEASE_ENV_DEFAULT))
  return path unless File.exist?(path)
  warn_if_shared!(path)
  File.foreach(path) do |raw|
    line = raw.strip
    next if line.empty? || line.start_with?("#")
    line = line.sub(/\Aexport\s+/, "")
    key, value = line.split("=", 2)
    next if value.nil?
    key = key.strip
    next unless keys.include?(key)
    value = value.strip.sub(/\A(["'])(.*)\1\z/, '\2')
    ENV[key] = value if ENV[key].to_s.strip.empty?
  end
  path
end

# The App Store Connect API key, from release.env. Every key is required.
def load_release_env!
  path = read_release_env!(RELEASE_ENV_KEYS)

  missing = RELEASE_ENV_KEYS.select do |key|
    value = ENV[key].to_s.strip
    value.empty? || value.include?("PASTE_")
  end
  unless missing.empty?
    where = File.exist?(path) ? path : "#{path} (the file does not exist)"
    UI.user_error!(
      "App Store Connect API key not configured. Fill in #{missing.join(', ')} in #{where}, " \
      "replacing any PASTE_ placeholder (README, \"Releasing to TestFlight\"). " \
      "The key is created in App Store Connect, Users and Access, Integrations, " \
      "App Store Connect API, with the App Manager role."
    )
  end

  key_path = File.expand_path(ENV["ASC_API_KEY_P8_PATH"].strip)
  unless File.file?(key_path)
    UI.user_error!("ASC_API_KEY_P8_PATH points at a file that does not exist: #{key_path}")
  end
  {
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"].strip,
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"].strip,
    key_path: key_path
  }
end

# --- iOS ---------------------------------------------------------------------------------

platform :ios do
  def ios_team_id!
    team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id).to_s.strip
    if team.empty?
      UI.user_error!(
        "No Apple Team ID. Set TEAM_ID in iosApp/Configuration/Local.xcconfig (README, " \
        "\"Signing for a real iPhone\") or MOYI_APPLE_TEAM_ID in the environment."
      )
    end
    team
  end

  # MARKETING_VERSION from Config.xcconfig: the version is decided there, by a commit.
  def ios_marketing_version
    config = File.read(File.join(REPO_ROOT, "iosApp/Configuration/Config.xcconfig"))
    m = config.match(/^\s*MARKETING_VERSION\s*=\s*(\S+)\s*$/)
    UI.user_error!("MARKETING_VERSION not found in iosApp/Configuration/Config.xcconfig") unless m
    m[1]
  end

  # The Release build bundles this Firebase config (the "Firebase Config" build phase). It is
  # git-ignored, so a fresh checkout lacks it; without it TestFlight testers get no push.
  def check_release_firebase_config!
    path = File.join(REPO_ROOT, "iosApp/Firebase/Release/GoogleService-Info.plist")
    unless File.file?(path)
      UI.user_error!(
        "Missing iosApp/Firebase/Release/GoogleService-Info.plist (moyi-prod's iOS app, " \
        "README \"Push notifications\"). Download it from the Firebase console."
      )
    end
    project = plist_value(path, "PROJECT_ID")
    bundle = plist_value(path, "BUNDLE_ID")
    unless project == FIREBASE_PROD_PROJECT && bundle == BUNDLE_ID
      UI.user_error!(
        "iosApp/Firebase/Release/GoogleService-Info.plist is for #{project.inspect} / " \
        "#{bundle.inspect}; Release needs #{FIREBASE_PROD_PROJECT} / #{BUNDLE_ID}."
      )
    end
    UI.message("Firebase Release config: #{project}, #{bundle}")
  end

  # Opens the built .ipa and checks what it will talk to before anything is uploaded.
  def verify_ipa!(ipa, marketing:, build:)
    Dir.mktmpdir("moyi-ipa") do |dir|
      _out, ok = quiet("unzip", "-q", "-o", ipa, "Payload/*.app/Info.plist", "-d", dir)
      UI.user_error!("Could not read Info.plist from #{ipa}") unless ok
      quiet("unzip", "-q", "-o", ipa, "Payload/*.app/GoogleService-Info.plist", "-d", dir)
      app = Dir.glob(File.join(dir, "Payload", "*.app")).first
      info = File.join(app, "Info.plist")
      firebase = File.join(app, "GoogleService-Info.plist")

      problems = []
      expect = lambda do |key, wanted|
        actual = plist_value(info, key)
        problems << "#{key} is #{actual.inspect}, expected #{wanted.inspect}" unless actual == wanted
      end
      expect.call("MoyiApiBaseUrl", PRODUCTION_API_BASE_URL)
      expect.call("CFBundleIdentifier", BUNDLE_ID)
      expect.call("CFBundleShortVersionString", marketing)
      expect.call("CFBundleVersion", build.to_s)
      %w[NSAppTransportSecurity NSLocalNetworkUsageDescription].each do |key|
        problems << "#{key} is present; a Release build has no ATS exception" if plist_has_key?(info, key)
      end
      if File.file?(firebase)
        project = plist_value(firebase, "PROJECT_ID")
        problems << "bundled Firebase project is #{project.inspect}, expected #{FIREBASE_PROD_PROJECT}" unless project == FIREBASE_PROD_PROJECT
      else
        problems << "no GoogleService-Info.plist in the app: the build would have no push"
      end

      unless problems.empty?
        UI.user_error!("The .ipa is not a production build; nothing was uploaded:\n- #{problems.join("\n- ")}")
      end
    end
    UI.success("The .ipa checks out: #{PRODUCTION_API_BASE_URL}, #{BUNDLE_ID} #{marketing} (#{build}), " \
               "no ATS exception, Firebase #{FIREBASE_PROD_PROJECT}")
  end

  desc "Archive the Release build (production API) and upload it to TestFlight, internal testing only"
  lane :beta do
    # 1. Everything that needs no network, cheapest first.
    sha = require_clean_commit!
    check_release_firebase_config!
    team_id = ios_team_id!
    asc = load_release_env!

    app_store_connect_api_key(
      key_id: asc[:key_id],
      issuer_id: asc[:issuer_id],
      key_filepath: asc[:key_path],
      in_house: false
    )

    # 2. The build number: one more than the last TestFlight build of this version, 1 if none.
    marketing = ios_marketing_version
    last = begin
      latest_testflight_build_number(version: marketing, app_identifier: BUNDLE_ID, initial_build_number: 0)
    rescue => e
      UI.user_error!(
        "Could not ask App Store Connect for the last build of #{marketing}: #{e.message}. " \
        "Check that the app record for #{BUNDLE_ID} exists and the API key has access."
      )
    end
    build = last.to_i + 1
    UI.message("Version #{marketing}: last TestFlight build #{last.to_i}, this one #{build}")

    # 3. Archive and export. Version and build number go in as build settings, so no file
    # is changed by a release. TEAM_ID is set here too, so the lane does not depend on
    # what Local.xcconfig overrides. gym does not hand the API key from
    # app_store_connect_api_key to xcodebuild, so the auth flags are passed through xcargs
    # (they reach both the archive and the export step).
    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", asc[:key_path],
      "-authenticationKeyID", asc[:key_id],
      "-authenticationKeyIssuerID", asc[:issuer_id]
    ].map { |a| Shellwords.escape(a) }.join(" ")
    # The App Store profile, made (or reused) through the API key and saved on this Mac, so the
    # export signs locally with the Apple Distribution certificate in the keychain. Xcode's own
    # automatic export would instead ask for cloud signing, which an App Manager key may not use
    # ("Cloud signing permission error", first run 2026-11-12).
    get_provisioning_profile(
      app_identifier: BUNDLE_ID,
      team_id: team_id
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.user_error!("No App Store profile for #{BUNDLE_ID} came back from sigh") if profile_name.to_s.empty?

    settings = "TEAM_ID=#{Shellwords.escape(team_id)} " \
               "MARKETING_VERSION=#{Shellwords.escape(marketing)} CURRENT_PROJECT_VERSION=#{build}"
    ipa_name = "Moyi-#{marketing}-#{build}.ipa"

    gym(
      project: File.join(REPO_ROOT, "iosApp/iosApp.xcodeproj"),
      scheme: "iosApp",
      configuration: "Release",
      output_directory: IOS_BUILD_DIR,
      output_name: ipa_name,
      xcargs: "#{settings} #{auth_args}",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      # export_method writes the plist's `method`; setting it in export_options too can
      # leave gym with duplicate keys.
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )
    ipa = File.join(IOS_BUILD_DIR, ipa_name)
    UI.user_error!("gym finished but #{ipa} is not there") unless File.file?(ipa)

    # 4. Prove it is a production build before it leaves the Mac.
    verify_ipa!(ipa, marketing: marketing, build: build)

    # 5. Upload. Internal testing only: no external groups, no review submission.
    notes = ENV["RELEASE_NOTES"].to_s.strip
    notes = "Internal test build #{sha[0, 7]}" if notes.empty?
    upload_to_testflight(
      app_identifier: BUNDLE_ID,
      ipa: ipa,
      changelog: notes,
      distribute_external: false,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded Moyi #{marketing} (#{build}) from #{sha[0, 7]} to TestFlight. " \
               "It shows in App Store Connect, TestFlight once Apple has processed it.")
  end

  desc "Check an .ipa is a production build, as beta does before uploading; uploads nothing. " \
       "fastlane ios check_ipa ipa:<path> build:<n> [version:<v>, default Config.xcconfig's]"
  lane :check_ipa do |options|
    ipa = File.expand_path(options[:ipa].to_s, REPO_ROOT)
    UI.user_error!("Pass ipa:<path to an .ipa>; #{ipa} is not a file") unless File.file?(ipa)
    UI.user_error!("Pass build:<the expected build number>") if options[:build].to_s.empty?
    verify_ipa!(ipa, marketing: (options[:version] || ios_marketing_version).to_s, build: options[:build].to_s)
  end
end

# --- Android -----------------------------------------------------------------------------

# The service account that may upload to Play. Its JSON holds a private key: it stays in
# ~/.moyi, never in the repository. PLAY_SERVICE_ACCOUNT_JSON in release.env (or the
# environment) points elsewhere.
PLAY_SERVICE_ACCOUNT_DEFAULT = "~/.moyi/play-service-account.json"
ANDROID_RELEASE_ENV_KEYS = %w[PLAY_SERVICE_ACCOUNT_JSON].freeze
# Play refuses a versionCode it has seen on any track, so the next one is above all of them.
PLAY_TRACKS = %w[internal alpha beta production].freeze
FIREBASE_DEV_PROJECT = "moyi-65b68"
ANDROID_BUILD_DIR = File.join(REPO_ROOT, "build", "android-release")
GRADLE_AAB = File.join(REPO_ROOT, "androidApp/build/outputs/bundle/release/androidApp-release.aab")
UPLOAD_SIGNING_PROPERTIES = %w[
  MOYI_UPLOAD_STORE_FILE
  MOYI_UPLOAD_STORE_PASSWORD
  MOYI_UPLOAD_KEY_ALIAS
  MOYI_UPLOAD_KEY_PASSWORD
].freeze

platform :android do
  # Releases come from main, as pushed: a commit nobody else can see is not released.
  # any_branch:true lifts this, for a rehearsal on a pull request's branch.
  def require_main_branch!(options)
    return UI.important("any_branch:true, so the branch is not checked") if options[:any_branch]
    branch, = quiet("git", "-C", REPO_ROOT, "rev-parse", "--abbrev-ref", "HEAD")
    UI.user_error!("Releases come from main; this checkout is on #{branch}. Pass any_branch:true to rehearse.") unless branch == "main"
    _out, pushed = quiet("git", "-C", REPO_ROOT, "merge-base", "--is-ancestor", "HEAD", "origin/main")
    UI.user_error!("HEAD is not on origin/main. Pull, or push through a pull request, first.") unless pushed
  end

  # versionName from androidApp/build.gradle.kts: decided there, by a commit.
  def android_version_name
    gradle = File.read(File.join(REPO_ROOT, "androidApp/build.gradle.kts"))
    m = gradle.match(/^\s*versionName\s*=\s*"([^"]+)"/)
    UI.user_error!("versionName not found in androidApp/build.gradle.kts") unless m
    m[1]
  end

  # The release build bundles this Firebase config. It is git-ignored, so a fresh checkout
  # lacks it; without it the build still succeeds but Play testers get no push.
  def check_android_release_firebase_config!
    path = File.join(REPO_ROOT, "androidApp/src/release/google-services.json")
    unless File.file?(path)
      UI.user_error!(
        "Missing androidApp/src/release/google-services.json (moyi-prod's Android app, " \
        "README \"Push notifications\"). Download it from the Firebase console."
      )
    end
    config = begin
      JSON.parse(File.read(path))
    rescue JSON::ParserError
      UI.user_error!("androidApp/src/release/google-services.json is not valid JSON")
    end
    project = config.dig("project_info", "project_id")
    packages = Array(config["client"]).map { |c| c.dig("client_info", "android_client_info", "package_name") }
    unless project == FIREBASE_PROD_PROJECT && packages.include?(BUNDLE_ID)
      UI.user_error!(
        "androidApp/src/release/google-services.json is for #{project.inspect} / " \
        "#{packages.inspect}; release needs #{FIREBASE_PROD_PROJECT} / #{BUNDLE_ID}."
      )
    end
    UI.message("Firebase release config: #{project}, #{BUNDLE_ID}")
  end

  # The upload key's four Gradle properties (issue #49). Without them Gradle builds an
  # unsigned bundle, which Play refuses; checking here fails in a second, not after a build.
  # Only the names are looked at, except the keystore path, which must exist.
  def check_upload_signing!
    gradle_home = File.expand_path(ENV.fetch("GRADLE_USER_HOME", "~/.gradle"))
    props_file = File.join(gradle_home, "gradle.properties")
    props = {}
    if File.file?(props_file)
      File.foreach(props_file) do |raw|
        key, value = raw.strip.split("=", 2)
        props[key.strip] = value.to_s.strip if value && UPLOAD_SIGNING_PROPERTIES.include?(key.strip)
      end
    end
    UPLOAD_SIGNING_PROPERTIES.each do |key|
      from_env = ENV["ORG_GRADLE_PROJECT_#{key}"].to_s.strip
      props[key] = from_env unless from_env.empty?
    end
    missing = UPLOAD_SIGNING_PROPERTIES.select { |key| props[key].to_s.empty? }
    unless missing.empty?
      UI.user_error!(
        "The Android upload key is not configured: #{missing.join(', ')} missing from " \
        "#{props_file} (issue #49). Without them the bundle is unsigned and Play refuses it."
      )
    end
    store = File.expand_path(props["MOYI_UPLOAD_STORE_FILE"], REPO_ROOT)
    UI.user_error!("MOYI_UPLOAD_STORE_FILE points at a keystore that does not exist") unless File.file?(store)
    UI.message("Upload key: the four MOYI_UPLOAD_* properties are set and the keystore exists")
  end

  # The Play service account's JSON key. Missing is the normal state until the owner makes
  # one, so the message says exactly how.
  def play_json_key!
    read_release_env!(ANDROID_RELEASE_ENV_KEYS)
    configured = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s.strip
    path = File.expand_path(configured.empty? ? PLAY_SERVICE_ACCOUNT_DEFAULT : configured)
    unless File.file?(path)
      UI.user_error!(
        "No Google Play service account key at #{path}. To make one (README, " \
        "\"Releasing to Google Play\"):\n" \
        "1. Google Cloud console, the project linked to the Play developer account: enable the " \
        "Google Play Android Developer API, then IAM and admin, Service accounts, Create " \
        "service account (no Cloud roles), Keys, Add key, JSON.\n" \
        "2. Move the downloaded file to #{PLAY_SERVICE_ACCOUNT_DEFAULT} and chmod 600 it, or set " \
        "PLAY_SERVICE_ACCOUNT_JSON in ~/.moyi/release.env to where it is.\n" \
        "3. Play Console, Users and permissions, Invite new users: the service account's email, " \
        "app #{BUNDLE_ID}, with Release apps to testing tracks and View app information."
      )
    end
    warn_if_shared!(path)
    key = begin
      JSON.parse(File.read(path))
    rescue JSON::ParserError
      UI.user_error!("#{path} is not valid JSON; download the service account key again (JSON, not P12)")
    end
    unless key["type"] == "service_account" && !key["client_email"].to_s.empty? && !key["private_key"].to_s.empty?
      UI.user_error!("#{path} is not a service account key (type service_account, with client_email and private_key)")
    end
    path
  end

  # Every versionCode Play already holds: on every track, and in the app's bundle library
  # (a bundle uploaded and then left off every track still claims its code).
  def play_version_codes(json_key)
    codes = PLAY_TRACKS.flat_map do |track|
      google_play_track_version_codes(package_name: BUNDLE_ID, track: track, json_key: json_key)
    end
    require "supply"
    require "supply/options"
    config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      { package_name: BUNDLE_ID, json_key: json_key }
    )
    client = Supply::Client.make_from_config(params: config)
    client.begin_edit(package_name: BUNDLE_ID)
    codes += Array(client.aab_version_codes) + Array(client.apks_version_codes)
    client.abort_current_edit
    codes.compact.map(&:to_i)
  rescue => e
    UI.user_error!(
      "Could not ask Google Play for #{BUNDLE_ID}'s version codes: #{e.message}. Check that " \
      "the app exists in Play Console and the service account was invited to it " \
      "(README, \"Releasing to Google Play\"). Invitations can take a few minutes to apply."
    )
  end

  # aapt2 from the newest build-tools of the Android SDK this checkout builds with.
  def aapt2!
    sdk_dir = ENV["ANDROID_HOME"].to_s.strip
    sdk_dir = ENV["ANDROID_SDK_ROOT"].to_s.strip if sdk_dir.empty?
    local = File.join(REPO_ROOT, "local.properties")
    if sdk_dir.empty? && File.file?(local)
      line = File.readlines(local).find { |l| l =~ /^\s*sdk\.dir\s*=/ }
      sdk_dir = line.split("=", 2).last.strip if line
    end
    sdk_dir = File.expand_path("~/Library/Android/sdk") if sdk_dir.empty?
    tools = Dir.glob(File.join(sdk_dir, "build-tools", "*", "aapt2"))
    UI.user_error!("No aapt2 under #{sdk_dir}/build-tools; install build-tools with the SDK Manager") if tools.empty?
    tools.max_by { |t| Gem::Version.new(File.basename(File.dirname(t))[/\A[\d.]+/] || "0") }
  end

  # Opens the .aab and checks what it will talk to before anything is uploaded.
  def verify_aab!(aab, version_name:, version_code:)
    problems = []
    Dir.mktmpdir("moyi-aab") do |dir|
      entries, ok = quiet("unzip", "-Z1", aab)
      UI.user_error!("Could not open #{aab} as a zip") unless ok
      entries = entries.lines.map(&:strip)

      # Signed with the upload key: jarsigner leaves a .SF and a .RSA/.EC/.DSA in META-INF/.
      signed = entries.any? { |e| e =~ %r{\AMETA-INF/[^/]+\.SF\z} } &&
               entries.any? { |e| e =~ %r{\AMETA-INF/[^/]+\.(RSA|EC|DSA)\z} }
      problems << "the bundle is not signed (is the upload key configured? issue #49)" unless signed

      # aapt2 reads a proto-format APK, which is what a bundle's base module holds: the
      # manifest and resources.pb moved to the root of a zip of their own.
      _out, ok = quiet("unzip", "-q", "-o", aab, "base/manifest/AndroidManifest.xml", "base/resources.pb",
                       "base/dex/*", "-d", dir)
      UI.user_error!("#{aab} has no base module manifest") unless ok
      base = File.join(dir, "base")
      FileUtils.cp(File.join(base, "manifest/AndroidManifest.xml"), File.join(base, "AndroidManifest.xml"))
      proto_apk = File.join(dir, "base.apk")
      _out, ok = quiet("zip", "-q", "-j", proto_apk, File.join(base, "AndroidManifest.xml"),
                       File.join(base, "resources.pb"))
      UI.user_error!("Could not repackage the base module for aapt2") unless ok

      aapt2 = aapt2!
      badging, ok = quiet(aapt2, "dump", "badging", proto_apk)
      UI.user_error!("aapt2 could not read the bundle's manifest") unless ok
      package = badging[/^package: name='([^']*)'/, 1]
      code = badging[/ versionCode='([^']*)'/, 1]
      name = badging[/ versionName='([^']*)'/, 1]
      problems << "package is #{package.inspect}, expected #{BUNDLE_ID.inspect}" unless package == BUNDLE_ID
      problems << "versionCode is #{code.inspect}, expected #{version_code.to_s.inspect}" unless code == version_code.to_s
      problems << "versionName is #{name.inspect}, expected #{version_name.inspect}" unless name == version_name

      manifest, = quiet(aapt2, "dump", "xmltree", "--file", "AndroidManifest.xml", proto_apk)
      problems << "the manifest is debuggable" if manifest =~ /:debuggable\(0x[0-9a-f]+\)=(true|-1)/
      problems << "the manifest allows cleartext traffic" if manifest =~ /:usesCleartextTraffic\(0x[0-9a-f]+\)=(true|-1)/
      problems << "the manifest has a network security config; release keeps Android's HTTPS-only default" if manifest =~ /:networkSecurityConfig\(/

      # The API base URL is a BuildConfig constant, compiled into the dex as a string.
      dex = Dir.glob(File.join(base, "dex", "*.dex")).map { |f| File.binread(f) }.join
      problems << "the code does not contain #{PRODUCTION_API_BASE_URL}" unless dex.include?(PRODUCTION_API_BASE_URL)
      problems << "the code contains the emulator's local backend (10.0.2.2)" if dex.include?("http://10.0.2.2")

      # Firebase's config becomes string resources (google-services plugin).
      resources = File.binread(File.join(base, "resources.pb"))
      problems << "no #{FIREBASE_PROD_PROJECT} Firebase config in the resources: the build would have no push" unless resources.include?(FIREBASE_PROD_PROJECT)
      problems << "the resources name the development Firebase project #{FIREBASE_DEV_PROJECT}" if resources.include?(FIREBASE_DEV_PROJECT)
    end

    unless problems.empty?
      UI.user_error!("The .aab is not a production build; nothing was uploaded:\n- #{problems.join("\n- ")}")
    end
    UI.success("The .aab checks out: #{PRODUCTION_API_BASE_URL}, #{BUNDLE_ID} #{version_name} (#{version_code}), " \
               "signed, not debuggable, no cleartext, Firebase #{FIREBASE_PROD_PROJECT}")
  end

  # Builds the release bundle with this versionCode, copies it to build/android-release/
  # and verifies it. Returns its path.
  def build_release_aab!(version_name:, version_code:)
    gradle(
      gradle_path: File.join(REPO_ROOT, "gradlew"),
      project_dir: REPO_ROOT,
      task: ":androidApp:bundleRelease",
      properties: { "moyi.versionCode" => version_code }
    )
    UI.user_error!("Gradle finished but #{GRADLE_AAB} is not there") unless File.file?(GRADLE_AAB)
    FileUtils.mkdir_p(ANDROID_BUILD_DIR)
    aab = File.join(ANDROID_BUILD_DIR, "Moyi-#{version_name}-#{version_code}.aab")
    FileUtils.cp(GRADLE_AAB, aab)
    verify_aab!(aab, version_name: version_name, version_code: version_code)
    aab
  end

  def positive_version_code!(value)
    code = Integer(value.to_s, 10) rescue nil
    UI.user_error!("version_code must be a whole number from 1 to 2100000000") unless code && code.between?(1, 2_100_000_000)
    code
  end

  desc "Build the signed release bundle (production API) and upload it to the Play internal track. " \
       "Options: release_status:draft (needed until Play has reviewed the app once), any_branch:true"
  lane :beta do |options|
    release_status = (options[:release_status] || "completed").to_s
    unless %w[completed draft].include?(release_status)
      UI.user_error!("release_status is completed (the default) or draft, not #{release_status.inspect}")
    end

    # 1. Everything that needs no network, cheapest first.
    sha = require_clean_commit!
    require_main_branch!(options)
    check_android_release_firebase_config!
    check_upload_signing!
    json_key = play_json_key!

    # 2. The versionCode: one more than the highest Play already holds, 1 if none.
    version_name = android_version_name
    codes = play_version_codes(json_key)
    version_code = (codes.max || 0) + 1
    UI.message("Version #{version_name}: highest versionCode on Play #{codes.max || 'none'}, this one #{version_code}")

    # 3. Build and prove it is a production build before it leaves the Mac.
    aab = build_release_aab!(version_name: version_name, version_code: version_code)

    # 4. Upload. Internal track only; no listing, images or screenshots are touched.
    begin
      upload_to_play_store(
        package_name: BUNDLE_ID,
        json_key: json_key,
        track: "internal",
        aab: aab,
        release_status: release_status,
        version_name: "#{version_name} (#{version_code})",
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    rescue => e
      raise unless e.message =~ /draft app/i
      UI.user_error!(
        "Play only takes draft releases until the app has been reviewed once (\"#{e.message}\"). " \
        "The edit was not committed. Run again with: fastlane android beta release_status:draft, " \
        "then roll the draft out to testers in Play Console, Testing, Internal testing."
      )
    end
    UI.success("Uploaded Moyi #{version_name} (#{version_code}) from #{sha[0, 7]} to the Play internal track " \
               "as #{release_status}: #{aab}")
  end

  desc "Build the signed release bundle with a given versionCode and check it, as beta does; asks Play " \
       "nothing and uploads nothing. fastlane android build_aab version_code:<n> [any_branch:true]"
  lane :build_aab do |options|
    version_code = positive_version_code!(options[:version_code])
    require_clean_commit!
    require_main_branch!(options)
    check_android_release_firebase_config!
    check_upload_signing!
    aab = build_release_aab!(version_name: android_version_name, version_code: version_code)
    UI.success("Built #{aab}; nothing was uploaded")
  end

  desc "Check an .aab is a production build, as beta does before uploading; uploads nothing. " \
       "fastlane android check_aab aab:<path> version_code:<n> [version_name:<v>, default build.gradle.kts's]"
  lane :check_aab do |options|
    aab = File.expand_path(options[:aab].to_s, REPO_ROOT)
    UI.user_error!("Pass aab:<path to an .aab>; #{aab} is not a file") unless File.file?(aab)
    verify_aab!(aab, version_name: (options[:version_name] || android_version_name).to_s,
                     version_code: positive_version_code!(options[:version_code]))
  end
end
