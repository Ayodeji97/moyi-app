# Moyi release lanes (README, "Releasing to TestFlight").
#
#   fastlane ios beta     archive the iOS Release build and upload it to TestFlight
#
# Run from the repository root. Android (Play internal track via `supply`) comes later, as
# its own `platform :android` block below the iOS one; the helpers at the top are shared.
#
# Secrets never live in this repository (it is public). The App Store Connect API key is
# read from ~/.moyi/release.env, which only the owner fills in. No value from it is ever
# printed: messages name the variable, never what it holds.

require "open3"
require "shellwords"
require "tmpdir"

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)

# The production API: what every Release build must talk to, the same as
# iosApp/scripts/api-base-url.sh and build-logic ApiBaseUrl.kt.
PRODUCTION_API_BASE_URL = "https://api.getmoyi.app/api/v1"
BUNDLE_ID = "app.getmoyi.moyi"
FIREBASE_PROD_PROJECT = "moyi-prod"

RELEASE_ENV_DEFAULT = "~/.moyi/release.env"
# Deliberately not APP_STORE_CONNECT_API_KEY_PATH: fastlane's pilot and
# latest_testflight_build_number read that name on their own and expect a JSON key file,
# not a .p8 (StitchPad learned this the hard way).
RELEASE_ENV_KEYS = %w[
  APP_STORE_CONNECT_API_KEY_ID
  APP_STORE_CONNECT_API_ISSUER_ID
  ASC_API_KEY_P8_PATH
].freeze

IOS_BUILD_DIR = File.join(REPO_ROOT, "build", "ios-release")

# --- Shared helpers ----------------------------------------------------------------------

# Runs a command without a shell and without fastlane echoing it. Returns [stdout, ok].
def quiet(*cmd)
  out, _err, status = Open3.capture3(*cmd)
  [out.strip, status.success?]
end

# One value from a plist (binary or XML), or nil when the key is absent.
def plist_value(path, key)
  out, ok = quiet("plutil", "-extract", key, "raw", "-o", "-", path)
  ok ? out : nil
end

def plist_has_key?(path, key)
  _out, ok = quiet("plutil", "-extract", key, "xml1", "-o", "-", path)
  ok
end

# The commit being released. Refuses a dirty tree, so what is uploaded is exactly a commit.
def require_clean_commit!
  status, ok = quiet("git", "-C", REPO_ROOT, "status", "--porcelain")
  UI.user_error!("git status failed: is #{REPO_ROOT} a git checkout?") unless ok
  unless status.empty?
    UI.user_error!(
      "The working tree has uncommitted changes. Commit or stash them first, so the " \
      "build that is uploaded matches a commit:\n#{status}"
    )
  end
  sha, = quiet("git", "-C", REPO_ROOT, "rev-parse", "HEAD")
  branch, = quiet("git", "-C", REPO_ROOT, "rev-parse", "--abbrev-ref", "HEAD")
  UI.message("Releasing commit #{sha} (#{branch})")
  sha
end

# Reads ~/.moyi/release.env (or $MOYI_RELEASE_ENV) into ENV. KEY=VALUE lines, # comments,
# optional `export ` and quotes. A variable already set in the environment wins, so a CI
# runner can provide them without the file. Only the keys this lane needs are read.
def load_release_env!
  path = File.expand_path(ENV.fetch("MOYI_RELEASE_ENV", RELEASE_ENV_DEFAULT))
  if File.exist?(path)
    mode = File.stat(path).mode & 0o777
    if (mode & 0o077) != 0
      UI.important("#{path} is readable by other users (mode #{format('%o', mode)}). Run: chmod 600 #{path}")
    end
    File.foreach(path) do |raw|
      line = raw.strip
      next if line.empty? || line.start_with?("#")
      line = line.sub(/\Aexport\s+/, "")
      key, value = line.split("=", 2)
      next if value.nil?
      key = key.strip
      next unless RELEASE_ENV_KEYS.include?(key)
      value = value.strip.sub(/\A(["'])(.*)\1\z/, '\2')
      ENV[key] = value if ENV[key].to_s.strip.empty?
    end
  end

  missing = RELEASE_ENV_KEYS.select do |key|
    value = ENV[key].to_s.strip
    value.empty? || value.include?("PASTE_")
  end
  unless missing.empty?
    where = File.exist?(path) ? path : "#{path} (the file does not exist)"
    UI.user_error!(
      "App Store Connect API key not configured. Fill in #{missing.join(', ')} in #{where}, " \
      "replacing any PASTE_ placeholder (README, \"Releasing to TestFlight\"). " \
      "The key is created in App Store Connect, Users and Access, Integrations, " \
      "App Store Connect API, with the App Manager role."
    )
  end

  key_path = File.expand_path(ENV["ASC_API_KEY_P8_PATH"].strip)
  unless File.file?(key_path)
    UI.user_error!("ASC_API_KEY_P8_PATH points at a file that does not exist: #{key_path}")
  end
  {
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"].strip,
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"].strip,
    key_path: key_path
  }
end

# --- iOS ---------------------------------------------------------------------------------

platform :ios do
  def ios_team_id!
    team = CredentialsManager::AppfileConfig.try_fetch_value(:team_id).to_s.strip
    if team.empty?
      UI.user_error!(
        "No Apple Team ID. Set TEAM_ID in iosApp/Configuration/Local.xcconfig (README, " \
        "\"Signing for a real iPhone\") or MOYI_APPLE_TEAM_ID in the environment."
      )
    end
    team
  end

  # MARKETING_VERSION from Config.xcconfig: the version is decided there, by a commit.
  def ios_marketing_version
    config = File.read(File.join(REPO_ROOT, "iosApp/Configuration/Config.xcconfig"))
    m = config.match(/^\s*MARKETING_VERSION\s*=\s*(\S+)\s*$/)
    UI.user_error!("MARKETING_VERSION not found in iosApp/Configuration/Config.xcconfig") unless m
    m[1]
  end

  # The Release build bundles this Firebase config (the "Firebase Config" build phase). It is
  # git-ignored, so a fresh checkout lacks it; without it TestFlight testers get no push.
  def check_release_firebase_config!
    path = File.join(REPO_ROOT, "iosApp/Firebase/Release/GoogleService-Info.plist")
    unless File.file?(path)
      UI.user_error!(
        "Missing iosApp/Firebase/Release/GoogleService-Info.plist (moyi-prod's iOS app, " \
        "README \"Push notifications\"). Download it from the Firebase console."
      )
    end
    project = plist_value(path, "PROJECT_ID")
    bundle = plist_value(path, "BUNDLE_ID")
    unless project == FIREBASE_PROD_PROJECT && bundle == BUNDLE_ID
      UI.user_error!(
        "iosApp/Firebase/Release/GoogleService-Info.plist is for #{project.inspect} / " \
        "#{bundle.inspect}; Release needs #{FIREBASE_PROD_PROJECT} / #{BUNDLE_ID}."
      )
    end
    UI.message("Firebase Release config: #{project}, #{bundle}")
  end

  # Opens the built .ipa and checks what it will talk to before anything is uploaded.
  def verify_ipa!(ipa, marketing:, build:)
    Dir.mktmpdir("moyi-ipa") do |dir|
      _out, ok = quiet("unzip", "-q", "-o", ipa, "Payload/*.app/Info.plist", "-d", dir)
      UI.user_error!("Could not read Info.plist from #{ipa}") unless ok
      quiet("unzip", "-q", "-o", ipa, "Payload/*.app/GoogleService-Info.plist", "-d", dir)
      app = Dir.glob(File.join(dir, "Payload", "*.app")).first
      info = File.join(app, "Info.plist")
      firebase = File.join(app, "GoogleService-Info.plist")

      problems = []
      expect = lambda do |key, wanted|
        actual = plist_value(info, key)
        problems << "#{key} is #{actual.inspect}, expected #{wanted.inspect}" unless actual == wanted
      end
      expect.call("MoyiApiBaseUrl", PRODUCTION_API_BASE_URL)
      expect.call("CFBundleIdentifier", BUNDLE_ID)
      expect.call("CFBundleShortVersionString", marketing)
      expect.call("CFBundleVersion", build.to_s)
      %w[NSAppTransportSecurity NSLocalNetworkUsageDescription].each do |key|
        problems << "#{key} is present; a Release build has no ATS exception" if plist_has_key?(info, key)
      end
      if File.file?(firebase)
        project = plist_value(firebase, "PROJECT_ID")
        problems << "bundled Firebase project is #{project.inspect}, expected #{FIREBASE_PROD_PROJECT}" unless project == FIREBASE_PROD_PROJECT
      else
        problems << "no GoogleService-Info.plist in the app: the build would have no push"
      end

      unless problems.empty?
        UI.user_error!("The .ipa is not a production build; nothing was uploaded:\n- #{problems.join("\n- ")}")
      end
    end
    UI.success("The .ipa checks out: #{PRODUCTION_API_BASE_URL}, #{BUNDLE_ID} #{marketing} (#{build}), " \
               "no ATS exception, Firebase #{FIREBASE_PROD_PROJECT}")
  end

  desc "Archive the Release build (production API) and upload it to TestFlight, internal testing only"
  lane :beta do
    # 1. Everything that needs no network, cheapest first.
    sha = require_clean_commit!
    check_release_firebase_config!
    team_id = ios_team_id!
    asc = load_release_env!

    app_store_connect_api_key(
      key_id: asc[:key_id],
      issuer_id: asc[:issuer_id],
      key_filepath: asc[:key_path],
      in_house: false
    )

    # 2. The build number: one more than the last TestFlight build of this version, 1 if none.
    marketing = ios_marketing_version
    last = begin
      latest_testflight_build_number(version: marketing, app_identifier: BUNDLE_ID, initial_build_number: 0)
    rescue => e
      UI.user_error!(
        "Could not ask App Store Connect for the last build of #{marketing}: #{e.message}. " \
        "Check that the app record for #{BUNDLE_ID} exists and the API key has access."
      )
    end
    build = last.to_i + 1
    UI.message("Version #{marketing}: last TestFlight build #{last.to_i}, this one #{build}")

    # 3. Archive and export. Version and build number go in as build settings, so no file
    # is changed by a release. TEAM_ID is set here too, so the lane does not depend on
    # what Local.xcconfig overrides. gym does not hand the API key from
    # app_store_connect_api_key to xcodebuild, so the auth flags are passed through xcargs
    # (they reach both the archive and the export step).
    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", asc[:key_path],
      "-authenticationKeyID", asc[:key_id],
      "-authenticationKeyIssuerID", asc[:issuer_id]
    ].map { |a| Shellwords.escape(a) }.join(" ")
    # The App Store profile, made (or reused) through the API key and saved on this Mac, so the
    # export signs locally with the Apple Distribution certificate in the keychain. Xcode's own
    # automatic export would instead ask for cloud signing, which an App Manager key may not use
    # ("Cloud signing permission error", first run 2026-11-12).
    get_provisioning_profile(
      app_identifier: BUNDLE_ID,
      team_id: team_id,
      readonly: false,
      force: false
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.user_error!("No App Store profile for #{BUNDLE_ID} came back from sigh") if profile_name.to_s.empty?

    settings = "TEAM_ID=#{Shellwords.escape(team_id)} " \
               "MARKETING_VERSION=#{Shellwords.escape(marketing)} CURRENT_PROJECT_VERSION=#{build}"
    ipa_name = "Moyi-#{marketing}-#{build}.ipa"

    gym(
      project: File.join(REPO_ROOT, "iosApp/iosApp.xcodeproj"),
      scheme: "iosApp",
      configuration: "Release",
      output_directory: IOS_BUILD_DIR,
      output_name: ipa_name,
      xcargs: "#{settings} #{auth_args}",
      clean: true,
      include_bitcode: false,
      include_symbols: true,
      # export_method writes the plist's `method`; setting it in export_options too can
      # leave gym with duplicate keys.
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )
    ipa = File.join(IOS_BUILD_DIR, ipa_name)
    UI.user_error!("gym finished but #{ipa} is not there") unless File.file?(ipa)

    # 4. Prove it is a production build before it leaves the Mac.
    verify_ipa!(ipa, marketing: marketing, build: build)

    # 5. Upload. Internal testing only: no external groups, no review submission.
    notes = ENV["RELEASE_NOTES"].to_s.strip
    notes = "Internal test build #{sha[0, 7]}" if notes.empty?
    upload_to_testflight(
      app_identifier: BUNDLE_ID,
      ipa: ipa,
      changelog: notes,
      distribute_external: false,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded Moyi #{marketing} (#{build}) from #{sha[0, 7]} to TestFlight. " \
               "It shows in App Store Connect, TestFlight once Apple has processed it.")
  end

  desc "Check an .ipa is a production build, as beta does before uploading; uploads nothing. " \
       "fastlane ios check_ipa ipa:<path> build:<n> [version:<v>, default Config.xcconfig's]"
  lane :check_ipa do |options|
    ipa = File.expand_path(options[:ipa].to_s, REPO_ROOT)
    UI.user_error!("Pass ipa:<path to an .ipa>; #{ipa} is not a file") unless File.file?(ipa)
    UI.user_error!("Pass build:<the expected build number>") if options[:build].to_s.empty?
    verify_ipa!(ipa, marketing: (options[:version] || ios_marketing_version).to_s, build: options[:build].to_s)
  end
end

