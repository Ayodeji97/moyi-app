<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The API client (PR #3 onwards). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The outbox sends again when the network returns (ConnectivityManager callback, and
         WorkManager's network constraint, whose own manifest declares it too). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: notifications are a runtime permission, asked only from Bond settings ›
         Notifications (NotificationPermissionPolicy). Below 13 it is granted at install. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice notes: asked only at the tap on "Record a voice note" in Write (rememberVoiceRecorder),
         never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- No backup and no device-to-device transfer (figma-deviations.md P3). Nothing
         on the device is worth restoring: the server holds the account and every
         entry, and the session is bound to an Android Keystore key that never leaves
         this device, so a restored session file could not be decrypted. The local
         entry cache to come (SQLDelight) will hold entry text, which must not travel
         to a backup at all. allowBackup="false" covers API 30 and below; from API 31
         it no longer stops device-to-device transfer, so dataExtractionRules
         excludes everything for both. The session file is also in noBackupFilesDir,
         a third guard. -->
    <application
        android:name=".MoyiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moyi">
        <!-- The channel FCM shows a push in when the push names none: every push until the
             server sends android.notification.channel_id (backend issue #134). The reveal's
             channel (NotificationChannels.DEFAULT_CHANNEL_ID; NotificationChannelsTest
             checks the two agree). Read by the Firebase SDK (firebase-messaging). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reveal" />
        <!-- The status-bar icon of a push the tray shows by itself (the app in the background).
             The status bar draws only the icon's shape, so the full-colour launcher icon would
             be a plain square; this is the mark alone, scaled to fill the 24 dp slot (ic_stat_moyi).
             MoyiMessagingService uses the same one for a push that arrives in the foreground. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_moyi" />
        <!-- FCM: a new token (onNewToken) and a push that arrives while the app is open
             (onMessageReceived). Not exported: only FCM, through Google Play services,
             starts it. Inert in a build without google-services.json (FirebasePush). -->
        <service
            android:name=".MoyiMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- adjustResize: the window keeps its size and Compose reads the keyboard as an
             inset (MoyiScaffold's safeDrawing), so the action rides on the keyboard.
             Without it Android may pan the whole window up when a field takes focus,
             pushing the header off the top (found on the composer, PR #8).
             singleTop: a tapped push opens the app with FLAG_ACTIVITY_CLEAR_TOP; standard
             would destroy and recreate the running activity, singleTop hands the tap to
             onNewIntent and keeps the screen and its state (MainActivity). -->
        <!-- The camera app writes the photo it takes here (rememberPhotoPicker, TakePicture):
             a content URI into cacheDir/camera, granted to that app for the one capture.
             Moyi declares no CAMERA permission, so the system camera app needs none from us.
             The file is deleted as soon as the prepared copy has been made. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: the three links the backend emails and shares open the app, verified
                 against https://getmoyi.app/.well-known/assetlinks.json (moyi-backend#157).
                 Exact paths only, so the rest of the site still opens in the browser, and the
                 same three the iOS AASA lists. One filter per verified host; https only.
                 The shell parses the URL again (DeepLink.parse) and routes it (LinkRouting). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="getmoyi.app" />
                <data android:path="/verify" />
                <data android:path="/reset-password" />
                <data android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
    </application>

</manifest>