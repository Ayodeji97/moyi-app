<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon (tools/icon/README.md): the mark in dark ink on dark surface, the same in
     either system mode, like the iOS icon. The monochrome layer is the same mark; a launcher
     with themed icons on (Android 13+) tints it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
