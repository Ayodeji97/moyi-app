-- Version 2 to 3: the outbox table (Outbox.sq). A phone that ran version 2 has
-- cached_day and draft; without this it would open the database and find no outbox.
CREATE TABLE outbox_entry (
    idempotency_key TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    bond_id TEXT NOT NULL,
    text TEXT NOT NULL,
    prompt_id TEXT,
    intended_at INTEGER NOT NULL,
    day_date TEXT NOT NULL,
    refused TEXT
);
